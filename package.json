{
  "name": "scalesquad",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server/main.ts",
    "build": "npm run db:generate && next build --webpack && tsc -p tsconfig.server.json",
    "start": "tsx --env-file-if-exists=.env dist/src/server/main.js",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:db": "vitest run --config vitest.db.config.ts",
    "sim": "tsx src/sim/cli/main.ts",
    "db:generate": "prisma generate --schema src/db/prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema src/db/prisma/schema.prisma",
    "db:seed": "tsx --env-file-if-exists=.env src/db/prisma/seed.ts",
    "prepare": "husky",
    "pwa:build": "node scripts/build-pwa.mjs",
    "pwa:icons": "node scripts/make-icons.mjs",
    "predev": "npm run pwa:build",
    "prebuild": "npm run pwa:build",
    "pretest": "npm run pwa:build",
    "pretest:cov": "npm run pwa:build",
    "test:e2e": "playwright test",
    "pretest:e2e": "npm run build",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:configured": "node tests/e2e/run-live.mjs",
    "test:e2e:local": "playwright test -c playwright.local.config.ts",
    "mobile:assets": "node scripts/mobile-assets.mjs",
    "mobile:assets:check": "node scripts/mobile-assets.mjs --check",
    "mobile:check": "node scripts/mobile-tool.mjs check",
    "mobile:test": "node scripts/mobile-tool.mjs test",
    "mobile:build": "node scripts/mobile-tool.mjs build"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@base-ui/react": "1.9.0",
    "@nexconn/chat": "26.2.1",
    "@nexconn/engine": "26.2.1",
    "@noble/hashes": "2.4.0",
    "@prisma/client": "6.19.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.68.0",
    "next": "16.4.5",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "0.4.6",
    "pino": "10.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "web-push": "3.6.7",
    "ws": "8.22.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "@types/ws": "8.18.2",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-boundaries": "7.4.1",
    "husky": "9.1.7",
    "jsdom": "30.1.3",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "prisma": "6.19.3",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "overrides": {
    "minimatch": "11.0.1",
    "@prisma/config": {
      "deepmerge-ts": "8.0.0"
    }
  }
}
